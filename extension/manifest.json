{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Agent Lens",
  "description": "__MSG_extDescription__",
  "version": "0.3.4",
  "default_locale": "en",
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "__MSG_actionTitle__", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://static-cdn.jtvnw.net/previews-ttv/*"],
  "content_scripts": [{
    "matches": ["https://www.twitch.tv/*"],
    "js": ["i18n.js", "ui-css.js", "match.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
